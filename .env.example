# All AI inference stays on this machine. Download models separately with Ollama.
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:14b
EMBED_MODEL=embeddinggemma:300m
DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_PDF_PAGES=5000
MAX_DOCUMENT_CHUNKS=30000
# Cosine cutoff is model/corpus dependent. Calibrate on your own questions.
MIN_SCORE=0.35
# Optional S3 backup; no AWS calls until explicitly running the CLI.
S3_ENABLED=false
S3_BUCKET=
S3_PREFIX=devops-rag/backups/
AWS_DEFAULT_REGION=eu-central-1
# Prefer aws sso login and AWS_PROFILE; never commit access keys.
# AWS_PROFILE=personal
# Optional customer-managed KMS key ARN. Otherwise AES256 SSE-S3 is used.
S3_KMS_KEY_ID=

# SQLite is the default; configure_postgres generates local credentials.
DATABASE_BACKEND=sqlite
DATABASE_URL=
POSTGRES_PORT=5433

# Container app port and host Ollama gateway (Podman default).
APP_PORT=8080
CONTAINER_OLLAMA_URL=http://host.containers.internal:11434
